{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": "vite",
  "proxy": { "entrypoint": "middleware.ts" },
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund && node scripts/vercel-cpu.mjs",
  "buildCommand": "node --experimental-strip-types scripts/check-update-release.mjs && npm run build && npm run check:site && npm run build:models",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 120,
      "supportsCancellation": true,
      "includeFiles": "{build/chat.mjs,build/models/qwen-lite.gguf,node_modules/node-llama-cpp/**,node_modules/@node-llama-cpp/linux-x64/**}"
    },
    "api/account.js": {
      "maxDuration": 30,
      "supportsCancellation": true,
      "includeFiles": "build/account.mjs"
    },
    "api/analytics.js": {
      "maxDuration": 20,
      "supportsCancellation": true,
      "includeFiles": "build/analytics.mjs"
    },
    "api/workspace.js": {
      "maxDuration": 90,
      "supportsCancellation": true,
      "includeFiles": "build/workspace.mjs"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0, no-transform" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src 'none'"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
