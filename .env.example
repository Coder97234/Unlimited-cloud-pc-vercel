# The default preview uses labeled sample replies. Built-in tools still work.
XYVORA_SERVER_MODELS=0

# Optional local test platform (Vite only; never use for production data).
# XYVORA_LOCAL_PLATFORM=1
# XYVORA_LOCAL_PLATFORM_DIR=.cache/xyvora-platform
# XYVORA_LOCAL_MAIL_DIR=.cache/xyvora-platform-mail

# Production platform; apply database/001_platform.sql and 002_launch.sql.
# Set on the server only. Never prefix any secret with VITE_.
# XYVORA_ACCOUNT_ORIGIN=https://xyvora.net
# XYVORA_DATABASE_URL=       # scoped PostgreSQL role, TLS with verified certificates
# XYVORA_ENABLE_PASSWORDS=1  # requires all three vars below; verified email + reset
# XYVORA_AUTH_SECRET=        # random, dedicated, at least 32 characters
# XYVORA_MAIL_API_KEY=       # Resend sending key
# XYVORA_MAIL_FROM=         # verified sending address, e.g. accounts@your-domain
# XYVORA_ENABLE_BACKGROUND=1 # requires a running npm run worker with its own role

# OAuth identity (independent of any plugin). Exact callback: https://xyvora.net/api/account
# XYVORA_LOGIN_GOOGLE_ID=
# XYVORA_LOGIN_GOOGLE_SECRET=
# XYVORA_LOGIN_GITHUB_ID=
# XYVORA_LOGIN_GITHUB_SECRET=
# XYVORA_LOGIN_DISCORD_ID=
# XYVORA_LOGIN_DISCORD_SECRET=

# Read-only account plugins are off by default. Callback: https://xyvora.net/api/workspace
# XYVORA_WORKSPACE_ORIGIN=https://xyvora.net
# XYVORA_CONNECT_SECRET=     # a different dedicated random secret
# XYVORA_GMAIL_PLUGIN_ENABLED=0
# XYVORA_GMAIL_CLIENT_ID=
# XYVORA_GMAIL_CLIENT_SECRET=
# XYVORA_VERCEL_PLUGIN_ENABLED=0
# XYVORA_VERCEL_CLIENT_ID=
# XYVORA_VERCEL_CLIENT_SECRET=

# Optional paid media. AI images is hidden unless both key and code are set.
# XYVORA_IMAGE_API_KEY=     # a dedicated OpenAI project with usage limits
# XYVORA_IMAGE_ACCESS_CODE= # dedicated random code, 24–180 characters
# XYVORA_ENABLE_VISION=1    # opt in to OpenAI image analysis with the same key/code
