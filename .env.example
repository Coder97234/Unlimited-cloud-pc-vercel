# The default local preview uses labeled sample replies. Built-in tools work.
XYVORA_SERVER_MODELS=0

# Set these only in the server environment. Never use a VITE_ prefix.
# XYVORA_WORKSPACE_ORIGIN=https://xyvora.net
# XYVORA_CONNECT_SECRET=     # a dedicated random secret, e.g. openssl rand -hex 32
# XYVORA_GMAIL_CLIENT_ID=
# XYVORA_GMAIL_CLIENT_SECRET=
# XYVORA_VERCEL_CLIENT_ID=
# XYVORA_VERCEL_CLIENT_SECRET=
# XYVORA_IMAGE_API_KEY=
# XYVORA_IMAGE_ACCESS_CODE=  # a dedicated random access code, at least 24 characters
# XYVORA_ENABLE_VISION=1    # opt in to OpenAI image analysis with the same key/code

# Optional Xyvora platform: run database/001_platform.sql before enabling.
# XYVORA_LOCAL_PLATFORM=1  # Vite only: embedded test storage, not production
# XYVORA_ACCOUNT_ORIGIN=https://xyvora.net
# XYVORA_DATABASE_URL=     # dedicated runtime role; TLS with verified certificates
# XYVORA_ENABLE_PASSWORDS=1 # optional; no password recovery
# XYVORA_ENABLE_BACKGROUND=1

# Optional social sign-in, separate from Gmail/Vercel plugin OAuth.
# Exact callback for each OAuth app: https://xyvora.net/api/account
# XYVORA_LOGIN_GOOGLE_ID=
# XYVORA_LOGIN_GOOGLE_SECRET=
# XYVORA_LOGIN_GITHUB_ID=
# XYVORA_LOGIN_GITHUB_SECRET=
# XYVORA_LOGIN_DISCORD_ID=
# XYVORA_LOGIN_DISCORD_SECRET=
