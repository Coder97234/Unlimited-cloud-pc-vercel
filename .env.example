# Copy to .env (never commit real values) and restart `npm start`.

# ---- the Windows machine (windows10.yml) ----
WINDOWS_USERNAME=user
WINDOWS_PASSWORD=changeme
WINDOWS_RAM=8G
WINDOWS_CPUS=4
WINDOWS_DISK=64G

# ---- where the site finds the desktop ----
# Local docker:      http://localhost:8006
# GitHub Codespace:  https://<codespace-name>-8006.app.github.dev
VM_DESKTOP_URL=
# Optional: what the "Start machine" button opens (defaults to the quickstart page)
VM_BOOT_URL=
# Optional: label shown in the PC toolbar
VM_LABEL=Windows 10
